{
  "schemaVersion": 1,
  "items": [
    {
      "id": "post",
      "term": "요청을 게시한다",
      "definition": "운영체제에 비동기 작업을 요청한다. 성공 반환 뒤에도 완료 처리가 남을 수 있다.",
      "aliases": [
        "post",
        "게시",
        "RIOSend",
        "RIOReceive"
      ],
      "chapters": [
        "P01",
        "C05",
        "C14"
      ],
      "level": "중급"
    },
    {
      "id": "completion",
      "term": "완료를 처리한다",
      "definition": "완료 큐에서 결과를 꺼내 요청 상태를 갱신한다. 상대 애플리케이션의 처리가 끝났다는 뜻은 아니다.",
      "aliases": [
        "completion",
        "완료",
        "CQ"
      ],
      "chapters": [
        "P01",
        "C05",
        "C12",
        "C15"
      ],
      "level": "중급"
    },
    {
      "id": "outstanding",
      "term": "아직 끝나지 않은 요청",
      "definition": "등록 버퍼를 참조하는 미완료 요청의 수다. syscall 실행 중인 posts_in_flight와 구분한다.",
      "aliases": [
        "outstanding",
        "in-flight",
        "미완료"
      ],
      "chapters": [
        "C08",
        "C15",
        "C17"
      ],
      "level": "중급"
    },
    {
      "id": "generation",
      "term": "세션 세대",
      "definition": "슬롯을 다시 사용할 때 바뀌는 연결 식별값이다. 인덱스와 함께 비교한다.",
      "aliases": [
        "generation",
        "session_uid",
        "session_unique_Id_",
        "세대"
      ],
      "chapters": [
        "P01",
        "C11"
      ],
      "level": "중급"
    },
    {
      "id": "backpressure",
      "term": "공간 부족으로 송신을 받지 못함",
      "definition": "정해진 송신 버퍼 용량이 부족하면 데이터를 받지 않고 반환값으로 알린다.",
      "aliases": [
        "backpressure",
        "배압",
        "kWouldBlock"
      ],
      "chapters": [
        "P01",
        "C14",
        "C20"
      ],
      "level": "중급"
    },
    {
      "id": "drain",
      "term": "남은 완료를 처리한다",
      "definition": "종료 시 남은 요청을 처리하는 과정이다. 대상 요청과 기다리는 기한을 함께 확인한다.",
      "aliases": [
        "drain",
        "배출"
      ],
      "chapters": [
        "C16",
        "C17"
      ],
      "level": "중급"
    },
    {
      "id": "coalescing",
      "term": "한꺼번에 묶어 보낸다",
      "definition": "송신 링의 대기 데이터를 한 요청으로 게시한다. 애플리케이션 패킷 경계를 변경하는 뜻은 아니다.",
      "aliases": [
        "coalescing",
        "송신 병합"
      ],
      "chapters": [
        "C14",
        "C15"
      ],
      "level": "중급"
    },
    {
      "id": "observability",
      "term": "로그와 지표로 상태를 확인한다",
      "definition": "요청의 위치와 실패 원인을 로그 문맥과 지표로 좁힌다.",
      "aliases": [
        "observability",
        "관측성",
        "metrics"
      ],
      "chapters": [
        "C22"
      ],
      "level": "중급"
    },
    {
      "id": "bounded_queue",
      "term": "용량이 정해진 큐",
      "definition": "정해진 항목 수나 바이트 용량을 넘으면 거절 등 정해진 정책을 적용한다.",
      "aliases": [
        "bounded queue",
        "유계 큐"
      ],
      "chapters": [
        "C18",
        "C20"
      ],
      "level": "중급"
    },
    {
      "id": "double_mapping",
      "term": "같은 메모리를 연속 주소 두 곳에 연결한다",
      "definition": "한 실제 저장소를 인접한 두 가상 주소 구간에 연결하여 링의 wrap 구간을 연속 주소로 다룬다.",
      "aliases": [
        "double mapping",
        "이중 매핑",
        "RingBufferVA2"
      ],
      "chapters": [
        "C09"
      ],
      "level": "중급"
    },
    {
      "id": "span",
      "term": "처리할 데이터의 범위를 빌려 본다",
      "definition": "소유권을 이전하거나 복사하지 않는 범위다. OnData의 범위는 콜백 반환 전까지만 유효하다.",
      "aliases": [
        "span",
        "view",
        "borrowed",
        "빌린 범위"
      ],
      "chapters": [
        "P02",
        "C03",
        "C12",
        "C18"
      ],
      "level": "중급"
    },
    {
      "id": "rq",
      "term": "요청 큐",
      "definition": "한 소켓의 RIO 송수신 요청을 게시하는 request queue다. 완료를 꺼내는 CQ와 역할이 다르다.",
      "aliases": [
        "RQ",
        "request queue",
        "요청 큐"
      ],
      "chapters": [
        "P01",
        "C05",
        "C10"
      ],
      "level": "중급"
    },
    {
      "id": "borrowed",
      "term": "빌린 데이터 범위",
      "definition": "소유권을 받지 않은 span·string_view다. 콜백 반환 뒤 보관하려면 유효할 때 복사한다.",
      "aliases": [
        "borrowed",
        "span",
        "string_view",
        "수명"
      ],
      "chapters": [
        "C03",
        "C07",
        "A01"
      ],
      "level": "중급"
    },
    {
      "id": "half-close",
      "term": "원격 송신 종료",
      "definition": "peer FIN은 더 이상 바이트를 보내지 않는다는 뜻이다. 이미 수락한 응답의 송신·완료가 남을 수 있다.",
      "aliases": [
        "FIN",
        "half-close",
        "peer drain"
      ],
      "chapters": [
        "C16"
      ],
      "level": "중급"
    },
    {
      "id": "parked-close",
      "term": "큐 밖에서 보관한 종료",
      "definition": "이벤트 링이 가득 찼을 때 종료 통지를 gate에 보존하고 앞선 이벤트 뒤 전달하는 상태다.",
      "aliases": [
        "parked close",
        "parked_generation",
        "종료 gate"
      ],
      "chapters": [
        "C18",
        "C17"
      ],
      "level": "중급"
    },
    {
      "id": "quarantine",
      "term": "재사용 전 대기",
      "definition": "닫힘 통지와 미완료 작업이 정리될 때까지 슬롯 재사용을 막는 수명 단계다.",
      "aliases": [
        "Quarantined",
        "격리",
        "재사용"
      ],
      "chapters": [
        "C11",
        "C16"
      ],
      "level": "중급"
    },
    {
      "id": "consume",
      "term": "앞부분을 소비한다",
      "definition": "읽기 가능한 데이터에서 처리가 끝난 연속 앞부분만 돌려준다. 완료된 수신량과 같을 필요가 없다.",
      "aliases": [
        "consume",
        "consumed_bytes",
        "소비량"
      ],
      "chapters": [
        "P01",
        "C12",
        "C13"
      ],
      "level": "중급"
    },
    {
      "id": "partial",
      "term": "부분 송신 완료",
      "definition": "요청한 전체보다 적은 바이트가 성공한 경우다. 성공한 앞부분만 비우고 나머지를 새 요청으로 게시한다.",
      "aliases": [
        "partial send",
        "부분 완료",
        "offset",
        "length"
      ],
      "chapters": [
        "C15"
      ],
      "level": "중급"
    },
    {
      "id": "double-map",
      "term": "한 저장소를 연속 가상 주소로 두 번 매핑한다",
      "definition": "링의 물리적 끝을 넘어도 연속 span으로 다루기 위한 주소 매핑이다. backing 메모리가 두 배라는 뜻은 아니다.",
      "aliases": [
        "double mapping",
        "DoubleMappedBuffer",
        "가상 주소"
      ],
      "chapters": [
        "C08",
        "C09",
        "C21"
      ],
      "level": "중급"
    },
    {
      "id": "deadline",
      "term": "공유 종료 시한",
      "definition": "여러 종료 단계가 같은 남은 시간을 사용하도록 정한 시점이다. 반환하지 않는 사용자 콜백의 강제 중단을 보장하지 않는다.",
      "aliases": [
        "deadline",
        "shutdown timeout",
        "시한"
      ],
      "chapters": [
        "C17"
      ],
      "level": "중급"
    },
    {
      "id": "p99",
      "term": "99백분위 지연",
      "definition": "지정한 표본·단위·계산법에서 99% 위치의 지연이다. 실행별 P99의 중앙값과 raw 표본을 합친 P99는 다르다.",
      "aliases": [
        "P99",
        "tail latency",
        "지연 분포"
      ],
      "chapters": [
        "C25"
      ],
      "level": "중급"
    },
    {
      "id": "counter",
      "term": "누적 계수",
      "definition": "발생 횟수나 합계를 누적한다. 현재 대기량을 뜻하는 gauge와 구분한다.",
      "aliases": [
        "counter",
        "gauge",
        "high-watermark",
        "지표"
      ],
      "chapters": [
        "C22"
      ],
      "level": "중급"
    },
    {
      "id": "abi",
      "term": "바이너리 호출 규약",
      "definition": "컴파일러·런타임·설정에 영향을 받는 C++ 바이너리 경계다. 정적 lib를 받았다는 사실만으로 다른 toolset과 호환되지 않는다.",
      "aliases": [
        "ABI",
        "/MD",
        "v145",
        "바이너리"
      ],
      "chapters": [
        "C27"
      ],
      "level": "중급"
    },
    {
      "id": "fixture",
      "term": "여러 구현이 공유하는 검증 입력",
      "definition": "C++·C#가 같은 wire 바이트와 예상 결과를 읽는다. 교육용 모델 사례·실제 네트워크 실행과 구분한다.",
      "aliases": [
        "fixture",
        "wire",
        "TSV",
        "검증 입력"
      ],
      "chapters": [
        "C19",
        "C24"
      ],
      "level": "중급"
    },
    {
      "id": "baseline",
      "term": "승인된 비교 기준",
      "definition": "동일 환경·workload·절차와 승인 정보를 보존한 측정 기준이다. 오래된 표나 임의 CSV를 곧바로 현재 승인으로 삼지 않는다.",
      "aliases": [
        "baseline",
        "approval.json",
        "기준선"
      ],
      "chapters": [
        "C25",
        "A04"
      ],
      "level": "중급"
    },
    {
      "id": "socket",
      "term": "소켓",
      "aliases": [
        "socket",
        "SOCKET"
      ],
      "definition": "프로그램이 네트워크 통신에 사용하는 통로다. 이 책에서는 연결을 받아 만든 Windows 소켓 핸들을 세션이 관리한다.",
      "chapters": [
        "P01",
        "C10"
      ],
      "level": "입문"
    },
    {
      "id": "port",
      "term": "포트",
      "aliases": [
        "port",
        "포트 번호"
      ],
      "definition": "같은 컴퓨터의 통신 서비스를 구별하는 번호다. 예제의 listen 포트와 클라이언트의 접속 대상 포트를 맞춘다.",
      "chapters": [
        "P01",
        "C02"
      ],
      "level": "입문"
    },
    {
      "id": "listen",
      "term": "접속 대기",
      "aliases": [
        "listen",
        "리스닝"
      ],
      "definition": "클라이언트가 들어올 수 있도록 문을 열고 기다리는 동작이다. Start 뒤 accept 스레드가 이 소켓에서 연결을 받는다.",
      "chapters": [
        "P01",
        "C10"
      ],
      "level": "입문"
    },
    {
      "id": "accept",
      "term": "연결 수락",
      "aliases": [
        "accept",
        "수락"
      ],
      "definition": "대기 중인 접속을 개별 통신 소켓으로 받는 동작이다. 성공 후 세션 슬롯과 워커를 연결하고 첫 수신을 게시한다.",
      "chapters": [
        "P01",
        "C10"
      ],
      "level": "입문"
    },
    {
      "id": "byte-stream",
      "term": "바이트 스트림",
      "aliases": [
        "byte stream",
        "TCP",
        "바이트 흐름"
      ],
      "definition": "순서는 있지만 메시지 경계는 없는 바이트의 흐름이다. OnData가 받은 구간과 애플리케이션 패킷 한 개의 크기는 다를 수 있다.",
      "chapters": [
        "P01",
        "C13"
      ],
      "level": "입문"
    },
    {
      "id": "length-prefix",
      "term": "길이 접두 헤더",
      "aliases": [
        "length prefix",
        "길이 헤더"
      ],
      "definition": "메시지 앞에 전체 길이를 기록한 표식이다. Echo는 헤더 자신을 포함한 길이를 4바이트에 기록한다.",
      "chapters": [
        "P01",
        "C13"
      ],
      "level": "입문"
    },
    {
      "id": "big-endian",
      "term": "빅 엔디언",
      "aliases": [
        "big endian",
        "network byte order"
      ],
      "definition": "여러 바이트의 숫자에서 큰 자릿수를 먼저 놓는 순서다. Echo의 00 00 00 07은 전체 길이 7을 뜻한다.",
      "chapters": [
        "P01",
        "C13"
      ],
      "level": "입문"
    },
    {
      "id": "callback",
      "term": "콜백",
      "aliases": [
        "callback",
        "EventHandler"
      ],
      "definition": "작업 결과를 알리려고 라이브러리가 부르는 애플리케이션 함수다. 같은 세션의 연결·데이터·종료 순서는 유지하지만 다른 세션과는 병행될 수 있다.",
      "chapters": [
        "P02",
        "C07"
      ],
      "level": "입문"
    },
    {
      "id": "thread",
      "term": "스레드",
      "aliases": [
        "thread",
        "실행 흐름"
      ],
      "definition": "CPU에서 명령을 차례로 실행하는 흐름이다. 세션마다 하나씩 만들지 않고 여러 세션의 완료를 적은 워커가 처리한다.",
      "chapters": [
        "P01",
        "C07"
      ],
      "level": "입문"
    },
    {
      "id": "worker",
      "term": "워커",
      "aliases": [
        "worker",
        "I/O worker"
      ],
      "definition": "큐에서 일을 꺼내 반복 처리하는 실행 담당자다. I/O 워커는 RIO 완료를 처리하고 게임 로직 워커는 복사된 이벤트를 처리한다.",
      "chapters": [
        "P02",
        "C07"
      ],
      "level": "입문"
    },
    {
      "id": "lock",
      "term": "잠금",
      "aliases": [
        "lock",
        "mutex",
        "락"
      ],
      "definition": "공유 상태를 동시에 바꾸지 못하게 하는 장치다. 송신 링의 상태는 잠금 안에서 정하되 운영체제 호출은 정해진 경계 밖에서 수행한다.",
      "chapters": [
        "C14"
      ],
      "level": "입문"
    },
    {
      "id": "atomic",
      "term": "원자 변수",
      "aliases": [
        "atomic",
        "std::atomic"
      ],
      "definition": "하나의 읽기·쓰기·교환을 쪼개지 않고 관찰하게 하는 변수다. 원자 변수 하나가 여러 필드 전체의 정합성까지 보장하지는 않는다.",
      "chapters": [
        "C11",
        "C17"
      ],
      "level": "입문"
    },
    {
      "id": "slot",
      "term": "슬롯",
      "aliases": [
        "slot",
        "index"
      ],
      "definition": "미리 마련한 저장 공간의 한 자리다. 세션 슬롯 번호는 재사용되므로 세대와 함께 비교한다.",
      "chapters": [
        "P02",
        "C10",
        "C11"
      ],
      "level": "입문"
    },
    {
      "id": "pool",
      "term": "풀",
      "aliases": [
        "pool",
        "세션 풀"
      ],
      "definition": "필요한 객체나 공간을 미리 모아 둔 저장소다. 연결마다 세션을 새로 할당하지 않고 비어 있는 슬롯을 빌린다.",
      "chapters": [
        "P02",
        "C10"
      ],
      "level": "입문"
    },
    {
      "id": "ring",
      "term": "링 버퍼",
      "aliases": [
        "ring buffer",
        "read",
        "write"
      ],
      "definition": "끝에 도달하면 처음으로 돌아가 사용하는 원형 저장소다. 읽기·쓰기 위치가 같아도 used 값으로 비어 있음과 가득 참을 구별한다.",
      "chapters": [
        "C09",
        "C12",
        "C14"
